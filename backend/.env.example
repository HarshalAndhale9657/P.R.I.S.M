# P.R.I.S.M. backend — environment configuration
# Copy to `.env` (git-ignored). Every variable is optional; defaults suit local development.
# Full list with descriptions: backend/app/settings.py

# ── Deployment ────────────────────────────────────────────────────────────────
PRISM_ENV=dev                          # dev | test | prod  (prod disables /docs)
PRISM_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
PRISM_TRUST_PROXY=false                # true only behind a reverse proxy you control (Caddy/nginx)
PRISM_LOG_FORMAT=text                  # text | json
PRISM_LOG_LEVEL=INFO
PRISM_SENTRY_DSN=

# ── Upload guards ─────────────────────────────────────────────────────────────
PRISM_MAX_FILE_BYTES=20971520          # 20 MiB per file
PRISM_MAX_REQUEST_BYTES=62914560       # 60 MiB paper + references per check
PRISM_MAX_REFERENCE_FILES=25
PRISM_MAX_PDF_PAGES=300

# ── Worker / queue (memory bound = MAX_PENDING_JOBS x MAX_REQUEST_BYTES) ──────
PRISM_WORKER_THREADS=2
PRISM_MAX_PENDING_JOBS=16
PRISM_JOB_TTL_SECONDS=1800             # manuscripts are purged from memory after this
PRISM_RATE_LIMIT_SUBMISSIONS=12        # per IP per window; 0 disables
PRISM_RATE_LIMIT_WINDOW_SECONDS=600

# ── Matching ──────────────────────────────────────────────────────────────────
PRISM_DATABASE_URL=                    # postgresql://user:pass@host:5432/prism — durable, replica-shared job state (ADR-0029); unset = memory
PRISM_DATABASE_POOL_SIZE=4
PRISM_AUTH_REQUIRED=false               # true = every submit/poll needs a valid Supabase JWT (ADR-0030)
PRISM_AUTH_JWT_SECRET=                  # Supabase project JWT secret (HS256) - Settings > API > JWT Settings
PRISM_AUTH_JWKS_URL=                    # or https://<ref>.supabase.co/auth/v1/.well-known/jwks.json (asymmetric)
PRISM_AUTH_ISSUER=                      # https://<ref>.supabase.co/auth/v1 (empty = not checked)
PRISM_AUTH_AUDIENCE=authenticated
PRISM_QUOTA_CHECKS=0                    # checks per signed-in user per window; 0 = unlimited; over -> 402
PRISM_QUOTA_WINDOW_SECONDS=86400
PRISM_NUMERIC_GUARD=true               # confident -> review when a match and its source share no figures (ADR-0026)
PRISM_NUMERIC_GUARD_GATE=0.20          # numeric agreement at or below which it fires (measured optimum)
PRISM_CONFIDENCE_SCALING=true          # raise the confident cutoff as the corpus grows (ADR-0024); false = fixed
PRISM_CONFIDENCE_SCALE_K=0.06          # cutoff increase per decade of corpus size
PRISM_CONFIDENCE_SCALE_PIVOT=500       # corpus size at which the base cutoff applies
PRISM_CONFIDENCE_CEILING=0.92
PRISM_EMBEDDING_CACHE_ENTRIES=50000    # cached sentence embeddings (~75 MB at 384 dims); 0 disables. Re-checks are ~6x faster warm.
PRISM_RERANK=false                     # cross-encoder rerank of borderline matches (W4; opt-in)
PRISM_RERANK_MODEL=cross-encoder-stsb
PRISM_WARMUP_MODELS=false              # true in prod so /health/ready is honest

# ── Academic corpus ───────────────────────────────────────────────────────────
PRISM_ACADEMIC_ENABLED=true
PRISM_CONTACT_EMAIL=                   # sent to OpenAlex/arXiv in the User-Agent (polite pool); set in prod
PRISM_S2_API_KEY=                      # Semantic Scholar key; the provider is enabled only when set (429 without one)
PRISM_ACADEMIC_FULLTEXT=true           # fetch open-access PDFs for the most relevant candidates -> verbatim matching against full text
PRISM_ACADEMIC_FULLTEXT_MAX_DOCS=8     # OA PDFs downloaded per check (each is size- and time-capped, cached 1h)
PRISM_ACADEMIC_FULLTEXT_MAX_BYTES=15728640
PRISM_ACADEMIC_FULLTEXT_TIMEOUT_SECONDS=15
