# P.R.I.S.M. Backend — Environment Configuration
# Copy this file to `.env` and fill in your key.
#
# The system runs fully OFFLINE without a key (degraded mode): PDF parsing,
# spaCy stylometry, HDBSCAN clustering, citation forensics and a rule-based
# report all work with zero API calls. Set the key below to additionally
# enable GPT style reasoning, GPT-4o report synthesis and OpenAI-embedding
# source tracing.

OPENAI_API_KEY=
