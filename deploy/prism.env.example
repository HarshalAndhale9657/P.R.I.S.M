# Production environment for the API container. Copy to prism.env (git-ignored) and edit.
# Everything not listed here keeps the default in backend/app/settings.py.

# Public origin(s) allowed to call the API. With Caddy serving the frontend on the same
# host this is just your domain.
PRISM_ALLOWED_ORIGINS=https://check.example.org

# Identifies us to OpenAlex (polite pool) and arXiv. Use a monitored mailbox.
PRISM_CONTACT_EMAIL=ops@example.org

# Semantic Scholar API key (free: https://www.semanticscholar.org/product/api). Adds a third academic
# provider; without a key the provider is skipped (unauthenticated calls are rate-limited to 429).
PRISM_S2_API_KEY=

# Open-access full text: download OA PDFs for the most relevant candidates so academic matches can be
# verbatim, not abstract-only. Each download is https-only, sniffed for %PDF, capped at 15 MiB, cached 1h.
PRISM_ACADEMIC_FULLTEXT=true
PRISM_ACADEMIC_FULLTEXT_MAX_DOCS=8

# Error tracking (optional).
PRISM_SENTRY_DSN=

# Capacity (defaults suit a 4 vCPU / 8 GB box; see settings.py for the memory arithmetic).
PRISM_WORKER_THREADS=2
PRISM_MAX_PENDING_JOBS=16
PRISM_RATE_LIMIT_SUBMISSIONS=12
PRISM_RATE_LIMIT_WINDOW_SECONDS=600

# Sentence-embedding cache (ADR-0023): a re-check after edits is ~6x faster with this warm.
# ~1.5 KB per entry, so 50 000 entries is roughly 75 MB of the container's 6 GB. 0 disables.
PRISM_EMBEDDING_CACHE_ENTRIES=50000

# Cross-encoder rerank of borderline matches (W4). Off until latency is measured on the
# real box (docs/PROGRESS.md). Requires the image built with PRISM_BAKE_RERANK=1.
PRISM_RERANK=false

# ── Durable job state (ADR-0029). Unset = in-process memory, ONE replica. Set to a Postgres DSN
# (Hetzner managed, or a container on the same box) and job state survives restarts and any replica
# can serve GET /api/v1/check/{id}; execution still runs on the replica that accepted the job.
PRISM_DATABASE_URL=
PRISM_DATABASE_POOL_SIZE=4

# ── Accounts (ADR-0030). Both unset = anonymous, exactly as before. Set ONE of the two from the
# Supabase project (Settings > API): the JWT secret (HS256) or the JWKS URL (asymmetric keys).
# A presented token is always verified; PRISM_AUTH_REQUIRED=true makes a token mandatory.
PRISM_AUTH_REQUIRED=false
PRISM_AUTH_JWT_SECRET=
PRISM_AUTH_JWKS_URL=
PRISM_AUTH_ISSUER=
PRISM_AUTH_AUDIENCE=authenticated
# Signed-in users get a per-user quota instead of the per-IP limiter; over it is 402. 0 = unlimited.
PRISM_QUOTA_CHECKS=0
PRISM_QUOTA_WINDOW_SECONDS=86400

# ── Coaching (ADR-0031). Dark until both are set. Only the flagged passage and the source excerpt
# are ever sent; use an OpenAI account with Zero Data Retention. Rules still decide what a flag is;
# the matcher post-filters every sentence the model returns.
PRISM_COACH_ENABLED=false
PRISM_OPENAI_API_KEY=
PRISM_COACH_MODEL=gpt-4o-mini
PRISM_COACH_MAX_PER_CHECK=3
PRISM_COACH_MAX_CALLS_PER_DAY=500
