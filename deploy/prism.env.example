# Production environment for the API container. Copy to prism.env (git-ignored) and edit.
# Everything not listed here keeps the default in backend/app/settings.py.

# Public origin(s) allowed to call the API. With Caddy serving the frontend on the same
# host this is just your domain.
PRISM_ALLOWED_ORIGINS=https://check.example.org

# Identifies us to OpenAlex (polite pool) and arXiv. Use a monitored mailbox.
PRISM_CONTACT_EMAIL=ops@example.org

# Semantic Scholar API key (free: https://www.semanticscholar.org/product/api). Adds a third academic
# provider; without a key the provider is skipped (unauthenticated calls are rate-limited to 429).
PRISM_S2_API_KEY=

# Open-access full text: download OA PDFs for the most relevant candidates so academic matches can be
# verbatim, not abstract-only. Each download is https-only, sniffed for %PDF, capped at 15 MiB, cached 1h.
PRISM_ACADEMIC_FULLTEXT=true
PRISM_ACADEMIC_FULLTEXT_MAX_DOCS=8

# Error tracking (optional).
PRISM_SENTRY_DSN=

# Capacity (defaults suit a 4 vCPU / 8 GB box; see settings.py for the memory arithmetic).
PRISM_WORKER_THREADS=2
PRISM_MAX_PENDING_JOBS=16
PRISM_RATE_LIMIT_SUBMISSIONS=12
PRISM_RATE_LIMIT_WINDOW_SECONDS=600

# Cross-encoder rerank of borderline matches (W4). Off until latency is measured on the
# real box (docs/PROGRESS.md). Requires the image built with PRISM_BAKE_RERANK=1.
PRISM_RERANK=false
